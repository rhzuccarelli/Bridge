#
# systemd unit - start the workstation at boot, like firmware.
#
# Install it (on the Pi):
#     ./scripts/install-autostart.sh
#
# Watch it:      journalctl -u audio-workstation -f
# Stop it:       sudo systemctl stop audio-workstation
# Disable it:    sudo systemctl disable audio-workstation
#
# Note: while this is running it owns the framebuffer, so stop it before running
# the app by hand or the two will fight over the panel.
#
[Unit]
Description=Audio Workstation
After=multi-user.target sound.target systemd-udev-settle.service
Wants=sound.target

[Service]
Type=simple
User=%USER%
WorkingDirectory=%DIR%
ExecStart=%DIR%/scripts/run-pi.sh --oled

Environment=HOME=/home/%USER%
Environment=AW_DISPLAY=oled
Environment=AW_INPUT=none
Environment=AW_GPIO_CHIP=gpiochip0
Environment=AW_PROJECTS_ROOT=/home/%USER%/audio-projects
Environment=AW_ALSA_DEVICE=hw:TP7,0
Environment=AW_MIDI_DEVICE=hw:TP7,0,0

# The UI thread is not realtime; the ALSA writer thread requests SCHED_FIFO.
LimitRTPRIO=95
LimitMEMLOCK=infinity

Restart=always
RestartSec=3

# There is no terminal, so send the log somewhere you can read it.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
